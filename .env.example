# Paste the existing REST Endpoint URL here. Do not commit your .env.
COGNIGY_REST_ENDPOINT_URL=
COGNIGY_ENDPOINT_API_KEY=
# Current Cognigy; older 2026.14/2026.15 deployments use x-rest-endpoint-key.
COGNIGY_API_KEY_HEADER=x-cognigy-endpoint-key
COGNIGY_TEST_MODE=true
COGNIGY_REQUEST_TIMEOUT_SECONDS=60
COGNIGY_DELAY_BETWEEN_REQUESTS_SECONDS=0.5
COGNIGY_DELAY_BETWEEN_RUNS_SECONDS=1
UC4_MAX_CONCURRENCY=1
# Opt-in: raw responses can contain sensitive data even after redaction.
UC4_RETAIN_RAW_EVIDENCE=false
# Optional JSON array of additional exact values to redact (names, IDs, etc.).
UC4_REDACT_VALUES=[]
